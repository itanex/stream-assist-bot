      "",
      "        beforeEach(() => {",
      "            jest.resetAllMocks();",
      "",
      "            subject = new ${2:Repository}(",
      "                database,",
      "                mockLogger,",
      "            );",
      "        });",
      "",
      "        afterEach(async () => {",
      "            await ${3:Dbo}.destroy({ where: {}, force: true });",
      "        });",
      "",
      "        $0",
      "    });",
      "});",
      ""
    ],
    "description": "Scaffolding for jest tests of database-backed Repositories (own database cloned from the test run's template)"
  }
