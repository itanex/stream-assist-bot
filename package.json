{
  "name": "stream-assist-bot",
  "version": "1.5.0",
  "description": "Twitch Bot for stream assistance, command interpretation, and additional processes.",
  "main": "app.ts",
  "type": "module",
  "dependencies": {
    "@sequelize/core": "7.0.0-alpha.48",
    "@twurple/api": "7.1.0",
    "@twurple/auth": "7.1.0",
    "@twurple/chat": "7.1.0",
    "@twurple/eventsub-base": "7.1.0",
    "@twurple/eventsub-http": "7.1.0",
    "@twurple/eventsub-ws": "7.1.0",
    "@twurple/pubsub": "7.1.0",
    "axios": "^1.17.0",
    "dayjs": "1.11.10",
    "dotenv": "16.4.5",
    "express": "^5.2.1",
    "https": "1.0.0",
    "inversify": "6.0.2",
    "md5": "2.3.0",
    "node-cron": "4.2.1",
    "pg": "8.11.5",
    "reflect-metadata": "0.2.2",
    "sequelize": "6.37.8",
    "sequelize-typescript": "2.1.6",
    "tedious": "19.2.1",
    "tsx": "4.23.11",
    "typescript": "5.9.2",
    "uuid": "11.1.1",
    "winston": "3.13.0",
    "winston-daily-rotate-file": "5.0.0",
    "ws": "8.20.1"
  },
  "devDependencies": {
    "@release-it/bumper": "^7.0.6",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/md5": "2.3.5",
    "@types/node": "24.13.3",
    "@types/node-cron": "3.0.11",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "8.61.0",
    "@typescript-eslint/parser": "8.61.0",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.29.1",
    "jest": "30.4.2",
    "jest-mock": "30.4.1",
    "release-it": "^20.2.1",
    "sequelize-cli": "6.6.5",
    "supertest": "^7.2.2",
    "ts-jest": "29.4.11"
  },
  "scripts": {
    "predev": "tsc --noEmit",
    "prestart": "tsc --noEmit",
    "start": "tsx app.ts",
    "dev": "tsx app.ts",
    "lint": "eslint . --ext .ts",
    "lint-fix": "eslint . --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --no-cache --detectOpenHandles",
    "test-coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --no-cache --coverage=true --detectOpenHandles",
    "test-specific": "node --experimental-vm-modules node_modules/jest/bin/jest.js --no-cache --detectOpenHandles --watch ./bot/commands/eightballcommand.spec.ts",
    "test-dev": "node --experimental-vm-modules node_modules/jest/bin/jest.js --no-cache --coverage=true --detectOpenHandles --watch",
    "release": "release-it"
  },
  "keywords": [
    "twitch",
    "bot",
    "streaming"
  ],
  "author": "Bryan Wood",
  "license": "GPLv3"
}
